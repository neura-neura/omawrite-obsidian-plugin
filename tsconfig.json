{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"obsidian": ["node_modules/obsidian"]
		},
		"target": "es6",
		"module": "esnext",
		"moduleResolution": "node",
		"strict": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"lib": ["dom", "es2018"],
		"types": ["node"]
	},
	"include": ["main.ts"]
}
